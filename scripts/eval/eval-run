# ---------------------------------------------------------------------------------------------------
# From criteria and observation to a result code
# ---------------------------------------------------------------------------------------------------

def state_of(checks):
    """erfuellt / nicht_erfuellt / manuell — the data view alone, not yet a result."""
    if any(c["erfuellt"] is False for c in checks):
        return "nicht_erfuellt"
    if any(c["erfuellt"] is None for c in checks):
        return "manuell"
    return "erfuellt"


def grade(task, state, observation, evidence_missing):
    """Result code per eval/10_MESSREGELN.md section 1, plus OFFEN where the rules cannot decide.

    Returns (code, reason). OFFEN is never turned into a result by guessing: an unanswered manual check,
    a missing help level or a missing snapshot stays open until a person decides.
    """
    begun = (observation.get("begonnen") or "").strip().lower()
    disturbance = (observation.get("stoerung") or "").strip().lower()
    helped = (observation.get("hoechste_hilfe") or "").strip().upper()
    handover = (observation.get("uebernahme") or "").strip().lower()
    manual_result = (observation.get("manuelles_ergebnis") or "").strip().upper()
    manual_reason = (observation.get("begruendung") or "").strip()
    manual_check = (observation.get("manuelle_pruefung") or "").strip().lower()

    if begun in ("nein", "no", "n"):
        return "N", "Aufgabe nicht begonnen"
    if disturbance in ("ja", "yes", "j"):
        return "X", "Störung oder Vorbereitungsfehler — nicht fair beurteilbar"
    if not begun:
        return "OFFEN", "Feld 'begonnen' fehlt"

    if manual_result in ("U", "A", "F", "X", "N"):
        if not manual_reason:
            return "OFFEN", "Manuelles Ergebnis ohne Begründung"
        return manual_result, f"manuell gesetzt: {manual_reason}"

    if evidence_missing:
        return "OFFEN", "Kein Snapshot zum Aufgabenende — Evidenz fehlt"
    if helped not in HELP_LEVELS:
        return "OFFEN", "Höchste Hilfestufe fehlt oder ist unzulässig"

    reason_ended = (observation.get("endgrund") or "").strip().lower()
    duration = (observation.get("dauer_s") or "").strip()
    if reason_ended in ABORT_REASONS_TIME:
        return "F", f"Abbruch nach dem Zeitlimit von {TIME_LIMIT_SECONDS} s"
    if duration.isdigit() and int(duration) > TIME_LIMIT_SECONDS:
        return ("OFFEN",
                f"Dauer {duration} s über dem Limit von {TIME_LIMIT_SECONDS} s, aber ohne Abbruchgrund "
                f"'zeitlimit' — Widerspruch im Protokoll")

    # H4 and a handover are failures even when the target state is present: a solution produced by the
    # moderator is not a participant success (10_MESSREGELN.md section 1).
    if helped == "H4" or handover in ("ja", "yes", "j"):
        if state == "erfuellt":
            return "F", "Sollzustand erreicht, aber durch H4 beziehungsweise Übernahme"
        return "F", "H4 beziehungsweise Übernahme"

    if state == "manuell":
        if manual_check in ("erfuellt", "erfüllt", "ok", "ja"):
            state = "erfuellt"
        elif manual_check in ("nicht_erfuellt", "nicht erfüllt", "nein"):
            state = "nicht_erfuellt"
        else:
            return "OFFEN", "Manuelle Sachprüfung offen"

    if state == "nicht_erfuellt":
        return "F", "Mindestens ein Sollkriterium nicht erfüllt"
    if helped in ("H0", "H1"):
        return "U", "Alle Sollkriterien erfüllt, keine Lösungshilfe"
    return "A", f"Alle Sollkriterien erfüllt, mit {helped}"


