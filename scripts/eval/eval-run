def participant_dir(code):
    return DATA_DIR / code


def cmd_start(args):
    code = args.participant
    target = participant_dir(code)
    snaps = target / "snapshots"
    if (snaps / "baseline.json").exists() and not args.force:
        die(f"Für {code} existiert bereits ein Ausgangszustand. --force überschreibt ihn.")
    snaps.mkdir(parents=True, exist_ok=True)

    container = db_container()
    state = snapshot(container)
    (snaps / "baseline.json").write_text(json.dumps(state, indent=2, ensure_ascii=False))

    # The T8 reference is read from the prepared audit state, not typed in by hand.
    audit = [r for r in state["audit"]
             if r["action"] == "CONSULTATION_UPDATED" and r["resource_type"] == "CONSULTATION"
             and r["success"]]
    reference = {}
    if len(audit) == 1:
        reference = {"resource_id": audit[0]["resource_id"], "actor": audit[0]["actor_username"],
                     "created_at": audit[0]["created_at"], "audit_id": audit[0]["id"]}

    meta = {
        "participant": code,
        "started_at": state["taken_at"],
        "commit": subprocess.run(["git", "-C", str(REPO_ROOT), "rev-parse", "HEAD"],
                                 capture_output=True, text=True).stdout.strip(),
        "criteria_version": CRITERIA_VERSION,
        "seed_file": "backend/src/main/resources/db/eval/R__seed_eval_baseline.sql",
        "t8_reference": reference,
        "t8_reference_eindeutig": len(audit) == 1,
        "audit_rows_at_start": len(state["audit"]),
    }
    (target / "meta.json").write_text(json.dumps(meta, indent=2, ensure_ascii=False))
    (DATA_DIR / ".current").write_text(code)

    print(f"Ausgangszustand für {code} gesichert: {snaps / 'baseline.json'}")
    print(f"Stand {meta['commit'][:7]}, Kriterien {CRITERIA_VERSION}")
    if reference:
        print(f"T8-Referenz: Angebot {reference['resource_id']}, {reference['actor']}, "
              f"{reference['created_at']} UTC")
    else:
        print("ACHTUNG: T8-Referenz nicht eindeutig. eval-reset.sh erneut ausführen.")


def cmd_checkpoint(args):
    code = args.participant or (DATA_DIR / ".current").read_text().strip() \
        if (args.participant or (DATA_DIR / ".current").exists()) else None
    if not code:
        die("Kein Studiencode. Entweder --participant angeben oder zuerst 'start' ausführen.")
    snaps = participant_dir(code) / "snapshots"
    if not (snaps / "baseline.json").exists():
        die(f"Für {code} fehlt der Ausgangszustand. Zuerst 'eval-run start --participant {code}'.")

    path = snaps / f"{args.task}.json"
    if path.exists() and not args.force:
        die(f"{args.task} ist für {code} bereits gesichert. --force überschreibt.")
    path.write_text(json.dumps(snapshot(db_container()), indent=2, ensure_ascii=False))
    print(f"{args.task} gesichert: {path}")


def read_observations(path):
    """One row per task. Unknown tasks are reported rather than ignored."""
    rows = {}
    with open(path, newline="", encoding="utf-8") as handle:
        for row in csv.DictReader(handle):
            task = (row.get("task") or "").strip().upper()
            if task:
                rows[task] = {k: (v or "") for k, v in row.items()}
    unknown = sorted(set(rows) - set(TASKS))
    if unknown:
        die(f"Unbekannte Aufgaben in der Beobachtungsdatei: {', '.join(unknown)}")
    return rows


def cmd_report(args):
    code = args.participant
    target = participant_dir(code)
    snaps = target / "snapshots"
    if not (snaps / "baseline.json").exists():
        die(f"Für {code} fehlt der Ausgangszustand.")

    base = json.loads((snaps / "baseline.json").read_text())
    meta = json.loads((target / "meta.json").read_text())
    observations = read_observations(args.observations) if args.observations else {}

    results = []
    # The state before the current task, in the order the tasks are worked through. T8 changes nothing
    # and is compared against this rather than against the baseline; every other task compares against
    # the baseline, because each one starts from the same prepared record.
    previous = base
    for task in TASKS:
        observation = observations.get(task, {})
        path = snaps / f"{task}.json"
        evidence_missing = not path.exists()
        end = json.loads(path.read_text()) if not evidence_missing else previous

        if task == "T8":
            checks = t8(previous, end, meta, observation)
        else:
            checks = CRITERIA[task](base, end, meta)
        previous = end
        state = state_of(checks)
        code_, reason = grade(task, state, observation, evidence_missing)

        results.append({
            "task": task,
            "zustand": state,
            "evidenz_fehlt": evidence_missing,
            "ergebnis": code_,
            "begruendung": reason,
            "hoechste_hilfe": (observation.get("hoechste_hilfe") or "").strip().upper() or None,
            "dauer_s": (observation.get("dauer_s") or "").strip() or None,
            "bedienfehler": (observation.get("bedienfehler") or "").strip() or None,
            "kritisch": (observation.get("kritisch") or "").strip() or None,
            "post_task": (observation.get("post_task") or "").strip() or None,
            "kriterien": checks,
        })

    counts = {c: sum(1 for r in results if r["ergebnis"] == c)
              for c in ("U", "A", "F", "X", "N", "OFFEN")}
    judgeable = counts["U"] + counts["A"] + counts["F"]
    provisional = counts["OFFEN"] > 0

    def rate(numerator):
        if judgeable == 0:
            return None
        return round(numerator / judgeable * 100, 1)

    summary = {
        "studiencode": code,
        "kriterien_version": CRITERIA_VERSION,
        "commit": meta.get("commit"),
        "seed": meta.get("seed_file"),
        "ausgangszustand": base["taken_at"],
        "erstellt": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "zaehlungen": counts,
        "n_beurteilbar": judgeable,
        "quote_ohne_hilfe": rate(counts["U"]),
        "quote_mit_hilfe": rate(counts["U"] + counts["A"]),
        "vorlaeufig": provisional,
        "aufgaben": results,
    }

    target.mkdir(parents=True, exist_ok=True)
    (target / "bericht.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False))
    write_csv(target / "bericht.csv", results)
    (target / "bericht.md").write_text(render_markdown(summary))
    print(f"Bericht geschrieben: {target}")
    print(render_markdown(summary))


def write_csv(path, results):
    with open(path, "w", newline="", encoding="utf-8") as handle:
        writer = csv.writer(handle)
        writer.writerow(["task", "ergebnis", "zustand", "evidenz_fehlt", "hoechste_hilfe",
                         "dauer_s", "bedienfehler", "kritisch", "post_task", "begruendung",
                         "offene_kriterien"])
        for r in results:
            open_checks = "; ".join(c["kriterium"] for c in r["kriterien"]
                                    if c["erfuellt"] is not True)
            writer.writerow([r["task"], r["ergebnis"], r["zustand"], r["evidenz_fehlt"],
                             r["hoechste_hilfe"] or "", r["dauer_s"] or "",
                             r["bedienfehler"] or "", r["kritisch"] or "", r["post_task"] or "",
                             r["begruendung"], open_checks])


def render_markdown(s):
    lines = [f"# Ergebnisbericht {s['studiencode']}", ""]
    lines += [f"- Kriterien: {s['kriterien_version']} · Stand: {(s['commit'] or '')[:7]}",
              f"- Ausgangszustand: {s['ausgangszustand']} · Bericht: {s['erstellt']}", ""]

    if s["vorlaeufig"]:
        lines += ["> **Vorläufig.** Es sind Fälle OFFEN. Die Quoten unten sind erst nach einer "
                  "manuellen Entscheidung zu diesen Fällen belastbar.", ""]

    c = s["zaehlungen"]
    lines += ["## Zusammenfassung", "",
              f"| U | A | F | X | N | OFFEN | beurteilbar |",
              "|---|---|---|---|---|---|---|",
              f"| {c['U']} | {c['A']} | {c['F']} | {c['X']} | {c['N']} | {c['OFFEN']} | "
              f"{s['n_beurteilbar']} |", ""]

    if s["n_beurteilbar"] == 0:
        lines += ["Erfolgsquoten: **nicht berechenbar** (Nenner 0).", ""]
    else:
        n = s["n_beurteilbar"]
        lines += [f"- Ohne Lösungshilfe: **{s['quote_ohne_hilfe']} %** ({c['U']} von {n})",
                  f"- Einschließlich Unterstützung: **{s['quote_mit_hilfe']} %** "
                  f"({c['U'] + c['A']} von {n})",
                  f"- Nicht beurteilbar: {c['X']} · nicht begonnen: {c['N']}", ""]
        if not s["vorlaeufig"]:
            lines += ["Satz zur Übernahme:", "",
                      f"> Studiencode {s['studiencode']}: {c['U']} von {n} beurteilbaren Aufgaben "
                      f"ohne Lösungshilfe abgeschlossen ({s['quote_ohne_hilfe']} %), einschließlich "
                      f"Unterstützung {c['U'] + c['A']} von {n} ({s['quote_mit_hilfe']} %). Von neun "
                      f"geplanten Aufgaben waren {c['X']} nicht beurteilbar und {c['N']} nicht "
                      f"begonnen.", ""]

    lines += ["Alle neun Aufgaben zählen gleich. Keine Teilpunkte, keine Verrechnung mit dem SUS. "
              "H1 ist wortgleiche Wiederholung und zählt zu U.", "", "## Aufgaben", ""]

    for r in s["aufgaben"]:
        flag = " · **Evidenz fehlt**" if r["evidenz_fehlt"] else ""
        lines += [f"### {r['task']} — {r['ergebnis']}{flag}", "",
                  f"{r['begruendung']}. Hilfestufe: {r['hoechste_hilfe'] or 'nicht erfasst'}.", "",
                  "| Kriterium | Ergebnis | Erwartet | Beobachtet |", "|---|---|---|---|"]
        for k in r["kriterien"]:
            mark = {True: "erfüllt", False: "**nicht erfüllt**", None: "manuell"}[k["erfuellt"]]
            lines.append(f"| {k['kriterium']} | {mark} | {k['erwartet']} | {k['beobachtet']} |")
        lines.append("")

    lines += ["---", "",
              "Datenbankzustände belegen Zielzustände. Sie ersetzen das Beobachtungsprotokoll nicht: "
              "Hilfen, Suchprobleme, Bedienfehler ohne gespeicherte Änderung und Bearbeitungszeit "
              "lassen sich daraus nicht rekonstruieren. Diese Kennzahlen gelten für eine Person und "
              "belegen keine allgemeine Systemqualität."]
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("start", help="Ausgangszustand sichern")
    p.add_argument("--participant", required=True)
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_start)

    p = sub.add_parser("checkpoint", help="Zustand am Aufgabenende sichern")
    p.add_argument("--task", required=True, choices=TASKS)
    p.add_argument("--participant")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_checkpoint)

    p = sub.add_parser("report", help="Bericht erzeugen")
    p.add_argument("--participant", required=True)
    p.add_argument("--observations")
    p.set_defaults(func=cmd_report)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
