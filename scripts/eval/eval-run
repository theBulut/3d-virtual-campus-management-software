def find(rows, key, value):
    for row in rows:
        if row.get(key) == value:
            return row
    return None


def check(label, ok, expected, observed):
    """ok is True, False, or None for "a person has to decide this".

    None must survive: coercing it to False would silently turn every criterion that needs human
    judgement into a failure.
    """
    return {"kriterium": label, "erfuellt": None if ok is None else bool(ok),
            "erwartet": expected, "beobachtet": observed}


def unchanged(label, before, after, fields, key, value):
    """Every listed field of one record has to survive the task untouched."""
    a = find(before, key, value) or {}
    b = find(after, key, value) or {}
    differing = [f for f in fields if a.get(f) != b.get(f)]
    return check(label, not differing, "unverändert",
                 "unverändert" if not differing
                 else ", ".join(f"{f}: {a.get(f)!r} → {b.get(f)!r}" for f in differing))


