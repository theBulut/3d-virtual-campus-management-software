def die(message):
    print(f"Abbruch: {message}", file=sys.stderr)
    sys.exit(1)


def db_container():
    """The db container of the study project — and only of that project."""
    out = subprocess.run(
        ["docker", "compose", "-f", str(REPO_ROOT / "docker-compose.yml"),
         "-f", str(REPO_ROOT / "docker-compose.eval.yml"), "ps", "-q", "db"],
        capture_output=True, text=True)
    container = out.stdout.strip().splitlines()
    if not container:
        die(f"Kein Datenbank-Container im Projekt '{PROJECT}'. Zuerst ./scripts/eval/eval-up.sh")
    label = subprocess.run(
        ["docker", "inspect", "--format",
         '{{ index .Config.Labels "com.docker.compose.project" }}', container[0]],
        capture_output=True, text=True).stdout.strip()
    if label != PROJECT:
        die(f"Container gehört zum Projekt '{label}', erwartet '{PROJECT}'.")
    return container[0]


def query(container, sql):
    """One read-only query, returned as a list of dicts."""
    wrapped = (
        "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY; "
        f"SELECT coalesce(json_agg(row_to_json(q)), '[]'::json) FROM ({sql}) q; COMMIT;"
    )
    out = subprocess.run(
        ["docker", "exec", "-i", container, "psql", "-v", "ON_ERROR_STOP=1", "-U", DB_USER,
         "-d", DB, "-t", "-A", "-c", wrapped],
        capture_output=True, text=True)
    if out.returncode != 0:
        die(f"Datenbankabfrage fehlgeschlagen: {out.stderr.strip()}")
    payload = [line for line in out.stdout.splitlines() if line.startswith(("[", "{"))]
    if not payload:
        die(f"Unerwartete Antwort der Datenbank: {out.stdout.strip()[:200]}")
    return json.loads(payload[0])


def snapshot(container):
    """The study objects, and only the fields the criteria look at."""
    return {
        "taken_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "accounts": query(container, """
            SELECT u.username, u.email, u.first_name, u.last_name, u.organisation,
                   u.is_active, u.must_change_password,
                   coalesce((SELECT array_agg(r.name ORDER BY r.name)
                             FROM user_role ur JOIN role r ON r.id = ur.role_id
                             WHERE ur.user_id = u.id), '{}') AS roles
            FROM admin_user u ORDER BY u.username"""),
        "buildings": query(container, """
            SELECT code, name_de, name_en, street, postal_code, city,
                   latitude, longitude, model_ref, is_published
            FROM building ORDER BY code"""),
        "pois": query(container, """
            SELECT p.name_de, p.name_en, p.description_de, p.description_en, p.category,
                   b.code AS building_code, p.position_x, p.position_y, p.position_z,
                   p.status, p.review_note,
                   o.username AS owner, a.username AS assigned_to
            FROM poi p
            LEFT JOIN building b ON b.id = p.building_id
            LEFT JOIN admin_user o ON o.id = p.created_by
            LEFT JOIN admin_user a ON a.id = p.assigned_to
            ORDER BY p.name_de"""),
        "consultations": query(container, """
            SELECT c.title_de, c.title_en, c.organisation, c.room, c.contact_email, c.is_published,
                   b.code AS building_code, r.username AS responsible,
                   coalesce((SELECT json_agg(json_build_object(
                                 'day_of_week', e.day_of_week,
                                 'start_time', to_char(e.start_time, 'HH24:MI'),
                                 'end_time', to_char(e.end_time, 'HH24:MI'),
                                 'valid_from', e.valid_from, 'valid_to', e.valid_to,
                                 'note', e.note)
                             ORDER BY e.day_of_week, e.start_time)
                             FROM consultation_event e WHERE e.consultation_id = c.id),
                            '[]'::json) AS events
            FROM consultation c
            LEFT JOIN building b ON b.id = c.building_id
            LEFT JOIN admin_user r ON r.id = c.responsible_user_id
            ORDER BY c.title_de"""),
        "audit": query(container, """
            SELECT id, action, resource_type, resource_id, actor_username, success, error_code,
                   to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS created_at
            FROM audit_log ORDER BY created_at DESC, id DESC LIMIT 50"""),
    }


