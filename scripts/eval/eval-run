def t8(before, end, meta, observation):
    """No data change. The answer is spoken, so the evidence is the observation sheet.

    `before` is the snapshot taken immediately before this task — T9 in the prescribed order, not the
    session baseline. Against the baseline every earlier task would show up here as a change.
    """
    reference = meta.get("t8_reference", {})
    given = {k: (observation.get(f"t8_antwort_{k}") or "").strip()
             for k in ("konto", "zeit", "ergebnis")}
    unchanged_data = (before["pois"] == end["pois"]
                      and before["consultations"] == end["consultations"]
                      and before["buildings"] == end["buildings"])
    return [
        check("Aufgabe verändert keinen Datenbestand", unchanged_data,
              "unverändert", "unverändert" if unchanged_data else "Daten wurden verändert"),
        check("Genanntes Konto", given["konto"] == reference.get("actor", "\0"),
              reference.get("actor", "[keine Referenz]"), given["konto"] or "nicht erfasst"),
        check("Genanntes Ergebnis", given["ergebnis"].lower() in ("erfolgreich", "ok", "ja"),
              "erfolgreich", given["ergebnis"] or "nicht erfasst"),
        check("Genannter Zeitpunkt — manuell gegen die lokale Anzeige",
              None, f"UTC {reference.get('created_at', '[keine Referenz]')} in lokaler Zeitzone",
              given["zeit"] or "nicht erfasst"),
    ]


