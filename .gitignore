.DS_Store
.env
.env.local
.claude
.vscode
.obsidian
# Local upload directory (CAMPUS_MEDIA_PATH default)
data/

# Unity-WebGL-Build. Nicht versioniert: hunderte MB Binärdaten, die sich aus dem Unity-Projekt
# jederzeit neu erzeugen lassen — 'Campus → WebGL-Build erzeugen'. Ohne den Build zeigt /play die
# Szenendaten als Liste, das System bleibt also auch nach einem frischen Klon vorführbar.
# Der Ordner selbst bleibt bestehen (.gitkeep): docker-compose.yml hängt ihn in den Frontend-Container
# ein, und ein fehlender Mountpunkt wäre ein Fehler statt einer leeren Liste.
frontend/public/game/*
!frontend/public/game/.gitkeep

# Das Unity-Sandkastenprojekt: von Unity Hub angelegt, mehrere GB Library/-Cache, und seit die Brücke
# in game/campus-bridge/ liegt keine Quelle mehr, sondern nur noch ein Testprojekt dafür.
# Einspielen mit ./game/install-bridge.sh "game/My project".
game/My project/

# Von install-bridge.sh in das Zielprojekt geschriebener Build-Pfad — er ist auf jedem Rechner anders.
CampusBuild.json
