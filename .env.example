# Copy to .env to override the defaults used by docker compose. The file is optional:
# `docker compose up --build` starts without it.
#
# .env is gitignored. Never commit real secrets.

# HS256 signing secret, at least 32 characters. When unset, the backend generates a random secret at
# startup — convenient, but every restart invalidates all issued tokens.
JWT_SECRET=

# Token lifetimes as ISO-8601 durations (spec section 7.1).
CAMPUS_JWT_ACCESS_TTL=PT15M
CAMPUS_JWT_REFRESH_TTL=P7D

# Initial administrator, created on first start if no active ADMIN exists (phase 2).
# The default password triggers a warning and, outside dev, a forced password change on first login.
CAMPUS_ADMIN_USERNAME=admin
CAMPUS_ADMIN_PASSWORD=admin
CAMPUS_ADMIN_EMAIL=admin@localhost

# Load the demo accounts and example content (phase 6). Only the dev profile picks up the demo
# migration location, so this stays off in docker.
CAMPUS_SEED_DEMO=false

# Upload directory. Inside the container this is the media_data volume.
CAMPUS_MEDIA_PATH=/data/media
